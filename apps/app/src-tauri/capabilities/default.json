{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-save",
    "fs:allow-write-file",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/markup",
          "sidecar": true,
          "args": [
            "install",
            {
              "validator": "^(claude-code|cursor|vscode|codex|opencode)$"
            }
          ]
        }
      ]
    }
  ]
}
