# Edge Function secrets. Copy to supabase/functions/.env for `supabase functions serve`, and set them
# on the project with `npx supabase secrets set --env-file supabase/functions/.env`. Never commit real values.
MAILER_URL=https://mail.kg-scripts.com/api/v1/send
MAILER_API_KEY=ik_live_...
# Authentication → Hooks → Send Email → "Generate secret" (looks like v1,whsec_...)
SEND_EMAIL_HOOK_SECRET=v1,whsec_...
# Optional: where replies to account emails go
MAIL_REPLY_TO=support@example.com
# Optional fallback for links when Supabase sends no site_url
SITE_URL=https://markup.here
